# Copy to .env (never commit .env). Test-mode credentials only.
# Model: the event-pinned ID is `meta-models/muse-spark-open-1026`.
# The public catalog ID is not authorized for the event key (403).
MODEL_ID=meta-models/muse-spark-open-1026
BASETEN_API_KEY=your-baseten-key-here
# Stripe test mode only (sk_test_). Live keys must never enter this repo.
STRIPE_TEST_KEY=sk_test_your-key-here
# Shopify dev-store custom-app token (shp_...). Dev stores only.
SHOPIFY_ADMIN_TOKEN=shp_your-token-here
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com

# TypeSafe Jev live-check only (experimental, not wired into /audit).
# Used by `python -m app.gate.live_check`; leave blank to skip.
TYPESAFE_API_KEY=
